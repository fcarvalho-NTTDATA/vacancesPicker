# Connection string da NeonDB (Settings > Connection Details no dashboard da Neon)
# Usa a connection string "pooled" para runtime e a mesma para migrations é normalmente suficiente.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Gerar com: npx auth secret   (ou: openssl rand -base64 33)
AUTH_SECRET="coloca-aqui-um-valor-aleatorio-longo"

# Usados apenas pelo script de seed (npm run db:seed) para criar o primeiro admin
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@exemplo.com"
SEED_ADMIN_PASSWORD="define-uma-password-forte"
